# ============================================
# FIVAA - Environment Variables para Vercel
# ============================================
# Copie este ficheiro e preencha os valores na Vercel
# ou importe diretamente na secção Settings > Environment Variables

# --- Convex ---
# Deployment URL (obtido via: npx convex dev)
CONVEX_DEPLOYMENT=dev:seu-deployment-id

# Public Convex URL (visível no navegador)
NEXT_PUBLIC_CONVEX_URL=https://seu-deployment-id.convex.cloud

# Convex Site URL (para autenticação)
NEXT_PUBLIC_CONVEX_SITE_URL=https://seu-deployment-id.convex.site

# Convex Site URL (usado no server-side pelo auth.config.ts)
CONVEX_SITE_URL=https://seu-deployment-id.convex.site

# --- JWT ---
# Chave privada JWT para autenticação (PEM PKCS#8 em uma linha)
# IMPORTANTE: Mantenha esta chave segura e nunca a exponha publicamente
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY----- ... -----END PRIVATE KEY-----"

# Chaves públicas correspondentes ao JWT_PRIVATE_KEY
JWKS={"keys":[{"kty":"RSA","n":"...","e":"AQAB","alg":"RS256","use":"sig","kid":"convex"}]}

# --- Proteção de Formulários ---
# Chave pública do Cloudflare Turnstile (carregada no browser)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAexemplo

# Chave secreta do Cloudflare Turnstile (somente server-side)
TURNSTILE_SECRET_KEY=0x4AAAAAAASECRETexemplo

# Segredo interno compartilhado entre Vercel e Convex para permitir submissões
# Configure o MESMO valor em ambos os ambientes.
FORM_SUBMISSION_SECRET=gere-um-segredo-longo-e-unico

# --- Admin ---
# Lista de e-mails com acesso administrativo no Convex
FIVAA_ADMIN_EMAILS=info@fivaa.com

# --- Bilheteira externa ---
# URLs oficiais de compra, uma por modalidade de acesso.
NEXT_PUBLIC_TICKET_URL_FORUMS=https://bilheteira.exemplo.com/fivaa-foruns
NEXT_PUBLIC_TICKET_URL_CONCERTS=https://bilheteira.exemplo.com/fivaa-concertos
NEXT_PUBLIC_TICKET_URL_TOTAL=https://bilheteira.exemplo.com/fivaa-total

# --- Next.js (opcional) ---
# NODE_ENV=production
